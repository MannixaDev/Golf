[gd_resource type="Resource" script_class="CardData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="1_carddata"]
[ext_resource type="Script" path="res://scripts/cards/effects/bag_synergy_effect.gd" id="2_synergy"]
[ext_resource type="Script" path="res://scripts/cards/effects/profile_tweak_effect.gd" id="3_tweak"]

[sub_resource type="Resource" id="Effect_travel_light"]
script = ExtResource("2_synergy")
summary = "Straighter for every club under twelve in the bag."
counts = 1
pivot = 12
fewer_is_better = true
max_steps = 3
dispersion_per_step = -0.05
sweet_spot_per_step = 0.04

[sub_resource type="Resource" id="Upgrade_travel_light"]
script = ExtResource("3_tweak")
summary = "And a touch longer."
distance_multiplier = 1.05

[resource]
script = ExtResource("1_carddata")
id = &"travel_light"
display_name = "Travel Light"
description = "You know exactly what is in there. That is the point."
type = 1
rarity = 2
cost = 1
effects = Array[CardEffect]([SubResource("Effect_travel_light")])
upgraded = false
upgraded_name = "Travel Light+"
upgrade_effects = Array[CardEffect]([SubResource("Upgrade_travel_light")])
upgrade_cost_delta = 0
upgrade_note = "And a touch longer."
