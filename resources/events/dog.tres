[ext_resource type="Script" path="res://scripts/events/event_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="2_outcome"]

[sub_resource type="Resource" id="Out_0"]
script = ExtResource("2_outcome")
label = "Chase it"
result_text = "Forty minutes across two fairways and a car park. You get the ball back. You are destroyed."
winnings_delta = 25
strokes_delta = 1

[sub_resource type="Resource" id="Out_1"]
script = ExtResource("2_outcome")
label = "Let it have the ball"
result_text = "The dog is delighted. Its owner apologises and presses something into your hand."
