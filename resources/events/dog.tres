[sub_resource type="Resource" id="Out_2"]
script = ExtResource("2_outcome")
label = "Trade it a club for the ball"
result_text = "An unusual negotiation, concluded entirely on the dog's terms."
winnings_delta = 45
removes_random_card = true

[resource]
script = ExtResource("1_spec")
id = &"dog"
title = "A Dog Has Your Ball"
body = "A big friendly thing, absolutely certain this is a game the two of you are playing together."
colour = Color(0.82, 0.66, 0.44, 1)
weight = 11.0
