[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="2_outcome"]

[sub_resource type="Resource" id="Out_0"]
script = ExtResource("2_outcome")
label = "Apologise profusely"
result_text = "Grovelling works. He softens, and mentions where the pin actually is on the next one."
upgrades_random_card = true

[sub_resource type="Resource" id="Out_1"]
script = ExtResource("2_outcome")
label = "Pay the fine  ·  50"
result_text = "There is a form. Of course there is a form. Matter closed."
winnings_delta = -50
requires_winnings = 50

[sub_resource type="Resource" id="Out_2"]
script = ExtResource("2_outcome")
label = "Walk away mid-sentence"
result_text = "Enormously satisfying. You play the rest of the round watched."
winnings_delta = 35
strokes_delta = 1

[resource]
script = ExtResource("1_spec")
id = &"secretary"
title = "The Club Secretary"
body = "He has noticed something about your attire, your pace of play, or the fact that you exist. It is not yet clear which."
colour = Color(0.78, 0.55, 0.82, 1)
weight = 10.0
min_holes_played = 2
outcomes = Array[EventOutcome]([SubResource("Out_0"), SubResource("Out_1"), SubResource("Out_2")])
