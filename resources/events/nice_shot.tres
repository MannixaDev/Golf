[gd_resource type="Resource" script_class="EventSpec" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/events/event_spec.gd" id="1_spec"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="2_outcome"]

[sub_resource type="Resource" id="Out_thank"]
script = ExtResource("2_outcome")
label = "Thank them through gritted teeth"
result_text = "You smile. Something in your swing does not."
strokes_delta = 1
winnings_delta = 15

[sub_resource type="Resource" id="Out_ignore"]
script = ExtResource("2_outcome")
label = "Pretend not to hear"
result_text = "You walk on. The moment passes. So does the jinx."

[resource]
script = ExtResource("1_spec")
id = &"nice_shot"
title = "Nice Shot!"
body = "Someone in the group behind shouts it while your ball is still in the air. It has not landed. It is not, as it turns out, a nice shot."
colour = Color(0.88, 0.45, 0.38, 1)
weight = 11.0
min_holes_played = 1
outcomes = Array[EventOutcome]([SubResource("Out_thank"), SubResource("Out_ignore")])
