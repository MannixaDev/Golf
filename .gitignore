# Godot's import cache and generated data. Regenerated on first open.
.godot/
*.import.md5
*.translation

# Builds. 144MB of them at the last count, and every one is reproducible from
# the source beside it -- the exe belongs on a Releases page, never in history.
build/

# Godot editor leftovers
.import/
export.cfg
export_credentials.cfg
*.tmp

# butler, if it is ever dropped in here. It is a 24MB binary that belongs on
# your PATH, not in the history of a text-only repository.
butler
butler.exe
# butler ships these beside it and will not run without them.
7z.dll
c7zip.dll
